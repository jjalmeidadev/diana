<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Communication</title>
    <link rel="icon" href="../../../assets/PNG_images/Union.png" type="image/png">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/public/css/communication.css">
</head>

<body>
    <!-- Top bar -->
    <%- include('../components/upperBar.ejs') %>
    <!-- Sidebar -->
    <%- include('../components/sideBar.ejs') %>

    <div class="main-content">
        <!-- Customer Service Channels Title -->
        <h1 class="page-title">Customer Service Channels</h1>

        <div class="contact-container">
            <!-- Contact Box 1 -->
            <div id="cttb1" class="contact-box">
                <div class="contact-header">
                    <img src="../../assets/PNG_images/support.jpeg" alt="Support Icon" class="contact-icon">
                    <span id="ctt1" class="contact-text">Contact the support team</span>
                </div>
                <div id="info1" class="contact-info">
                    <p><i class="fas fa-envelope"></i><strong>Email:</strong> contact@stpauls.br</p>
                    <p><i class="fas fa-phone"></i><strong>Phone:</strong> +55 (11) 3087-3399</p>
                    <p><i class="fas fa-clock"></i><strong>Hours:</strong> Monday to Friday, 7am to 5pm</p>
                </div>
            </div>

            <!-- Contact Box 2 -->
            <div id="cttb2" class="contact-box">
                <div class="contact-header">
                    <img src="../../assets/PNG_images/tutor.jpeg" alt="Tutor Icon" class="contact-icon">
                    <span id="ctt2" class="contact-text">Contact a tutor</span>
                </div>
                <div id="info2" class="contact-info">
                    <p><i class="fas fa-envelope"></i><strong>Email:</strong> admissionsstp@stpauls.br</p>
                    <p><i class="fas fa-phone"></i><strong>Phone:</strong> +55 11 3087‑3399</p>
                    <p><i class="fas fa-clock"></i><strong>Hours:</strong> Monday to Friday, 7am to 5pm</p>
                </div>
            </div>

            <!-- Contact Box 3 -->
            <div id="cttb3" class="contact-box">
                <div class="contact-header">
                    <img src="../../assets/PNG_images/teacher.jpeg" alt="Teacher Icon" class="contact-icon">
                    <span id="ctt3" class="contact-text">Contact a teacher</span>
                </div>
                <div id="info3" class="contact-info">
                    <p><i class="fas fa-envelope"></i><strong>Email:</strong> head@stpauls.br</p>
                    <p><i class="fas fa-phone"></i><strong>Phone:</strong> +55 11 3087‑3399</p>
                    <p><i class="fas fa-clock"></i><strong>Hours:</strong> Monday to Friday, 7am to 5pm</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <%- include('../components/lowerBar.ejs') %>
    
    <script>
        $(document).ready(function() {
            // Função para alternar a visibilidade das informações
            function toggleInfo(infoId) {
                $('.contact-info').not(infoId).slideUp(200);
                $(infoId).slideToggle(200);
            }

            // Adiciona eventos de clique para cada box
            $("#cttb1").click(function() {
                toggleInfo("#info1");
            });

            $("#cttb2").click(function() {
                toggleInfo("#info2");
            });

            $("#cttb3").click(function() {
                toggleInfo("#info3");
            });

            $("#cttb4").click(function() {
                toggleInfo("#info4");
            });
        });
    </script>
</body>

</html>