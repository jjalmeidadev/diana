<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Communication</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f5f5f5;
        }

        .main-content {
            margin-left: 250px;
            padding: 20px;
            min-height: calc(100vh - 60px);
            background-color: #f5f5f5;
        }

        .page-title {
            color: #333;
            text-align: center;
            margin-bottom: 30px;
            font-size: 2em;
            font-weight: 600;
            position: relative;
            padding-bottom: 10px;
        }

        .page-title::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 3px;
            background-color: #007bff;
            border-radius: 2px;
        }

        .contact-container {
            display: flex;
            flex-direction: column;
            gap: 20px;
            max-width: 600px;
            margin: 0 auto;
        }

        .contact-box {
            background: white;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            width: 100%;
        }

        .contact-box:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
        }

        .contact-box::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            height: 100%;
            width: 4px;
            background-color: #007bff;
            transform: scaleY(0);
            transition: transform 0.3s ease;
        }

        .contact-box:hover::before {
            transform: scaleY(1);
        }

        .contact-header {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 15px;
        }

        .contact-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
        }

        .contact-text {
            font-size: 1.1em;
            font-weight: 600;
            color: #333;
        }

        .contact-info {
            display: none;
            margin-top: 15px;
            padding: 20px;
            background: #f8f9fa;
            border-radius: 12px;
            font-size: 0.95em;
            color: #495057;
            border: 1px solid #e9ecef;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }

        .contact-info p {
            margin: 12px 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .contact-info strong {
            color: #212529;
            min-width: 120px;
        }

        .contact-info i {
            color: #6c757d;
            width: 20px;
        }
    </style>
</head>

<body>
    <!-- Top bar -->
    <%- include('../components/upperBar.ejs') %>
    <!-- Sidebar -->
    <%- include('../components/sideBar.ejs') %>

    <!-- Event boxes area -->
    <div class="main-content">
        <!-- Customer Service Channels Title -->
        <h1 class="page-title">Customer Service Channels</h1>

        <div class="contact-container">
            <!-- Contact Box 1 -->
            <div id="cttb1" class="contact-box">
                <div class="contact-header">
                    <img src="../../assets/PNG_images/avatar.png" alt="Support Icon" class="contact-icon">
                    <span id="ctt1" class="contact-text">Contact the support team</span>
                </div>
                <div id="info1" class="contact-info">
                    <p><i class="fas fa-envelope"></i><strong>Email:</strong> contact@stpauls.br</p>
                    <p><i class="fas fa-phone"></i><strong>Phone:</strong> (11) 3087-3399</p>
                    <p><i class="fas fa-clock"></i><strong>Hours:</strong> Monday to Friday, 8am to 6pm</p>
                </div>
            </div>

            <!-- Contact Box 2 -->
            <div id="cttb2" class="contact-box">
                <div class="contact-header">
                    <img src="../../assets/PNG_images/avatar.png" alt="Tutor Icon" class="contact-icon">
                    <span id="ctt2" class="contact-text">Contact a tutor</span>
                </div>
                <div id="info2" class="contact-info">
                    <p><i class="fas fa-envelope"></i><strong>Email:</strong> tutors@stpauls.br</p>
                    <p><i class="fas fa-phone"></i><strong>Phone:</strong> (11) 3087-3398</p>
                    <p><i class="fas fa-clock"></i><strong>Hours:</strong> Monday to Friday, 9am to 5pm</p>
                </div>
            </div>

            <!-- Contact Box 3 -->
            <div id="cttb3" class="contact-box">
                <div class="contact-header">
                    <img src="../../assets/PNG_images/avatar.png" alt="Teacher Icon" class="contact-icon">
                    <span id="ctt3" class="contact-text">Contact a teacher</span>
                </div>
                <div id="info3" class="contact-info">
                    <p><i class="fas fa-envelope"></i><strong>Email:</strong> teachers@school.com</p>
                    <p><i class="fas fa-phone"></i><strong>Phone:</strong> (11) 3087-3397</p>
                    <p><i class="fas fa-clock"></i><strong>Hours:</strong> Monday to Friday, 8am to 4pm</p>
                </div>
            </div>

            <!-- Contact Box 4 -->
            <div id="cttb4" class="contact-box">
                <div class="contact-header">
                    <img src="../../assets/PNG_images/avatar.png" alt="Secretary Icon" class="contact-icon">
                    <span id="ctt4" class="contact-text">Contact the secretary</span>
                </div>
                <div id="info4" class="contact-info">
                    <p><i class="fas fa-envelope"></i><strong>Email:</strong> secretary@school.com</p>
                    <p><i class="fas fa-phone"></i><strong>Phone:</strong> (11) 3087-3396</p>
                    <p><i class="fas fa-clock"></i><strong>Hours:</strong> Monday to Friday, 7am to 5pm</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <%- include('../components/lowerBar.ejs') %>
    
    <script>
        $(document).ready(function() {
            // Função para alternar a visibilidade das informações
            function toggleInfo(infoId) {
                $('.contact-info').not(infoId).slideUp(200);
                $(infoId).slideToggle(200);
            }

            // Adiciona eventos de clique para cada box
            $("#cttb1").click(function() {
                toggleInfo("#info1");
            });

            $("#cttb2").click(function() {
                toggleInfo("#info2");
            });

            $("#cttb3").click(function() {
                toggleInfo("#info3");
            });

            $("#cttb4").click(function() {
                toggleInfo("#info4");
            });
        });
    </script>
</body>

</html>