<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Assignments</title>
  <link rel="icon" href="../../../assets/PNG_images/Union.png" type="image/png">
  <link rel="stylesheet" href="/public/css/assignments.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet" />
</head>

<body>
  <!-- Top bar -->
  <%- include('../components/upperBar.ejs') %>
    <!-- Sidebar -->
    <%- include('../components/sideBar.ejs') %>

      <div class="main main-content">
        <div class="main-header-row">
          <h1>Assignments</h1>
          <div class="dropdown">
            <button class="dropbtn blue">Filter by subject</button>
            <div class="dropdown-content">
              <a href="#">Geography</a>
              <a href="#">Art</a>
              <a href="#">Mathematics</a>
            </div>
          </div>
        </div>
        <div class="assignments-list">
          <div class="assignment-card completed">
            <div class="assignment-info">
              <div class="assignment-title">Geography - Map Project</div>
              <div class="assignment-details">Due: 10/06/2025</div>
            </div>
            <div class="assignment-status">Completed</div>
          </div>
          <div class="assignment-card pending">
            <div class="assignment-info">
              <div class="assignment-title">Art - Modern Art Essay</div>
              <div class="assignment-details">Due: 15/06/2025</div>
            </div>
            <div class="assignment-status">Pending</div>
          </div>
          <div class="assignment-card late">
            <div class="assignment-info">
              <div class="assignment-title">Mathematics - Algebra Worksheet</div>
              <div class="assignment-details">Due: 05/06/2025</div>
            </div>
            <div class="assignment-status">Late</div>
          </div>
        </div>
      </div>

      <!-- Footer -->
      <%- include('../components/lowerBar.ejs') %>

        <script src="/public/scripts/assignments.js"></script>

        <!-- Popup de detalhes da atividade -->
        <div id="assignment-popup" class="assignment-popup-overlay" style="display:none;">
          <div class="assignment-popup">
            <span class="close-popup">&times;</span>
            <h2 id="popup-title">Assignment Title</h2>
            <div id="popup-status" class="popup-status">Status</div>
            <div id="popup-due" class="popup-due">Due: </div>
            <div id="popup-desc" class="popup-desc">Description of the assignment will appear here.</div>
            <button class="popup-btn">Mark as Done</button>
          </div>
        </div>

        <script>
          let selectedAssignmentCard = null;

          document.addEventListener('DOMContentLoaded', function() {
            // Ao clicar em um assignment-card, abre o popup e guarda o card clicado
            document.querySelectorAll('.assignment-card').forEach(function(card) {
              card.addEventListener('click', function() {
                selectedAssignmentCard = card;
                document.getElementById('assignment-popup').style.display = 'flex';
              });
            });

            // Ao clicar em Mark as Done, remove apenas o card selecionado
            document.querySelector('.popup-btn').addEventListener('click', function() {
              if (selectedAssignmentCard) {
                selectedAssignmentCard.remove();
                selectedAssignmentCard = null;
              }
              document.getElementById('assignment-popup').style.display = 'none';
            });

            // Fecha o popup ao clicar no X
            document.querySelector('.close-popup').addEventListener('click', function() {
              document.getElementById('assignment-popup').style.display = 'none';
              selectedAssignmentCard = null;
            });
          });
        </script>
</body>

</html>