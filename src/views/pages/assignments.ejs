<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Assignments</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet" />
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: 'Inter', sans-serif;
      background-color: #f5f5f5;
    }

    .main-content {
      margin-left: 360px;
      margin-top: 100px;
      margin-bottom: 50px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }

    .assignment-box {
      cursor: pointer;
      width: 520px;
      height: 55px;
      background: #000;
      border-radius: 22px;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: flex-start;
      padding-left: 24px;
      font-size: 20px;
      font-weight: 600;
      border: 1px solid #000;
      margin-top: 20px;
      transition: background 0.3s, transform 0.2s;
    }

    .assignment-box:first-child {
      margin-top: 0;
    }

    .assignment-box:hover {
      background: #222;
      transform: scale(1.01);
    }

    .assignment-box img {
      height: 40px;
      margin-right: 18px;
    }
  </style>
</head>

<body>
  <!-- Top bar -->
  <%- include('../components/upperBar.ejs') %>

  <!-- Sidebar -->
  <%- include('../components/sideBar.ejs') %>

  <!-- Assignment boxes -->
  <div class="main-content">
    <% for(let i = 0; i < 9; i++) { %>
      <div class="assignment-box">
        <img src="../../assets/PNG_images/profileplaceholder.png" alt="Assignment" />
        <span>Assignment</span>
      </div>
    <% } %>
  </div>

  <!-- Footer -->
  <%- include('../components/lowerBar.ejs') %>
</body>

</html>
