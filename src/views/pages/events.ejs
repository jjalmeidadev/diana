<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Events</title>
<link rel="stylesheet" href="/public/css/events.css">
</head>

<body>
    <!-- Top bar -->
    <%- include('../components/upperBar.ejs') %>
    <!-- Sidebar -->
    <%- include('../components/sideBar.ejs') %>

    <div class="content-wrapper">
        <div class="events-container">
            <!-- School Events Title -->
            <h1 style="font-family: Arial, sans-serif; color: #333; margin-top: 40px;">School Events</h1>

            <!-- Row of event boxes -->
            <div style="display: flex; justify-content: center; gap: 40px; margin-top: 40px; margin-bottom: 120px;">
                <!-- Event Card 1 -->
                <div style="
                    width: 320px; background: #fff; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);
                    overflow: hidden; text-align: center; padding-bottom: 20px;
                    display: flex; flex-direction: column; align-items: center;
                ">
                    <img src="../../assets/PNG_images/event1.png" alt="Prep School Showcase" style="
                        width: 100%; height: 180px; object-fit: cover; border-bottom: 1px solid #eee;
                    ">
                    <div style="padding: 15px;">
                        <h3 style="font-size: 1.1em; color: #0056b3; margin-bottom: 5px; font-weight: bold;">Prep School Showcase</h3>
                        <p style="font-size: 0.9em; color: #555; margin-bottom: 10px;">Students present projects and performances. Parents join to celebrate their achievements.</p>
                        <p style="font-size: 0.8em; color: #777; margin-bottom: 15px;">04/06/2025 - 3 PM</p>
                        <p style="font-size: 0.9em; color: #333; margin-bottom: 10px;">Are you going?</p>
                        <div style="display: flex; justify-content: center; gap: 10px;">
                            <button style="
                                background-color: #0056b3; color: white; padding: 8px 20px;
                                border: none; border-radius: 5px; cursor: pointer; font-size: 0.9em;
                            ">Yes</button>
                            <button style="
                                background-color: #f4f4f4; color: #333; padding: 8px 20px;
                                border: 1px solid #ccc; border-radius: 5px; cursor: pointer; font-size: 0.9em;
                            ">No</button>
                        </div>
                    </div>
                </div>

                <!-- Event Card 2 -->
                <div style="
                    width: 320px; background: #fff; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);
                    overflow: hidden; text-align: center; padding-bottom: 20px;
                    display: flex; flex-direction: column; align-items: center;
                ">
                    <img src="../../assets/PNG_images/events2.png" alt="International Day Family Celebration" style="
                        width: 100%; height: 180px; object-fit: cover; border-bottom: 1px solid #eee;
                    ">
                    <div style="padding: 15px;">
                        <h3 style="font-size: 1.1em; color: #0056b3; margin-bottom: 5px; font-weight: bold;">International Day Family Celebration</h3>
                        <p style="font-size: 0.9em; color: #555; margin-bottom: 10px;">A cultural festival with food, music, and activities. Families share and enjoy diverse traditions.</p>
                        <p style="font-size: 0.8em; color: #777; margin-bottom: 15px;">24/06/2025 - 6 PM</p>
                        <p style="font-size: 0.9em; color: #333; margin-bottom: 10px;">Are you going?</p>
                        <div style="display: flex; justify-content: center; gap: 10px;">
                            <button style="
                                background-color: #0056b3; color: white; padding: 8px 20px;
                                border: none; border-radius: 5px; cursor: pointer; font-size: 0.9em;
                            ">Yes</button>
                            <button style="
                                background-color: #f4f4f4; color: #333; padding: 8px 20px;
                                border: 1px solid #ccc; border-radius: 5px; cursor: pointer; font-size: 0.9em;
                            ">No</button>
                        </div>
                    </div>
                </div>

                <!-- Event Card 3 -->
                <div style="
                    width: 320px; background: #fff; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);
                    overflow: hidden; text-align: center; padding-bottom: 20px;
                    display: flex; flex-direction: column; align-items: center;
                ">
                    <img src="../../assets/PNG_images/events3.png" alt="Prep School Showcase" style="
                        width: 100%; height: 180px; object-fit: cover; border-bottom: 1px solid #eee;
                    ">
                    <div style="padding: 15px;">
                        <h3 style="font-size: 1.1em; color: #0056b3; margin-bottom: 5px; font-weight: bold;">Prep School Showcase</h3>
                        <p style="font-size: 0.9em; color: #555; margin-bottom: 10px;">Students present projects and performances. Parents join to celebrate their achievements.</p>
                        <p style="font-size: 0.8em; color: #777; margin-bottom: 15px;">04/06/2025 - 3 PM</p>
                        <p style="font-size: 0.9em; color: #333; margin-bottom: 10px;">Are you going?</p>
                        <div style="display: flex; justify-content: center; gap: 10px;">
                            <button style="
                                background-color: #0056b3; color: white; padding: 8px 20px;
                                border: none; border-radius: 5px; cursor: pointer; font-size: 0.9em;
                            ">Yes</button>
                            <button style="
                                background-color: #f4f4f4; color: #333; padding: 8px 20px;
                                border: 1px solid #ccc; border-radius: 5px; cursor: pointer; font-size: 0.9em;
                            ">No</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <%- include('../components/lowerBar.ejs') %>
</body>

</html>