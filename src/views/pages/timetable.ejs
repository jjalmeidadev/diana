<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Timetable</title>
  <link rel="stylesheet" href="/public/css/timetable.css">
</head>

<body style="margin: 0; padding: 0;">
  <!-- Top bar -->
  <%- include('../components/upperBar.ejs') %>

  <!-- Sidebar -->
  <%- include('../components/sideBar.ejs') %>

  <!-- Timetable content -->
  <div class="main-content" style="padding: 0 30px;">
    <div class="carousel-container">
      <!-- Setas acima da imagem -->
      <div class="carousel-controls">
        <button class="arrow-button" onclick="prevImage()">←</button>
        <button class="arrow-button" onclick="nextImage()">→</button>
      </div>

      <!-- Botão de download -->
      <div style="text-align: center; margin-bottom: 10px;">
        <a id="downloadLink" class="arrow-button" download="timetable.jpg">Baixar imagem</a>
      </div>

      <!-- Imagens -->
      <div class="carousel">
        <img src="assets/PNG_images/timetable.jpg" class="active" />
        <img src="assets/PNG_images/timetable2.jpg" />
      </div>
    </div>
  </div>

  <!-- Footer -->
  <%- include('../components/lowerBar.ejs') %>

  <script>
    const images = document.querySelectorAll(".carousel img");
    let current = 0;

    function showImage(index) {
      images.forEach((img) => img.classList.remove("active"));
      images[index].classList.add("active");
      updateDownloadLink();
    }

    function nextImage() {
      current = (current + 1) % images.length;
      showImage(current);
    }

    function prevImage() {
      current = (current - 1 + images.length) % images.length;
      showImage(current);
    }

    function updateDownloadLink() {
      const activeImage = document.querySelector(".carousel img.active");
      const downloadLink = document.getElementById("downloadLink");
      if (activeImage) {
        downloadLink.href = activeImage.src;
        const filename = activeImage.src.split("/").pop();
        downloadLink.download = filename;
      }
    }

    // Atualiza o link no carregamento inicial
    updateDownloadLink();
  </script>
</body>
</html>