<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reports</title>
    <link rel="stylesheet" href="public/css/reports.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>
    <!-- Top bar -->
    <%- include('../components/upperBar.ejs') %>
    <!-- Sidebar -->
    <%- include('../components/sideBar.ejs') %>

    <!-- Main content area -->
    <div class="main-content">
        <h1>Reports</h1>
    
        <div class="controls">
            <div class="select-wrapper">
                <select id="report-select">
                    <option value="">--Select a report--</option>
                    <!-- Add report options here -->
                </select>
            </div>
            <button class="btn-download">Download</button>
        </div>
    
        <div class="content-grid">
            <div class="chart-container">
                <h3>Total Average per subject</h3>
                <canvas id="reportsChart"></canvas>
            </div>
            <div class="table-container">
                <table class="reports-table">
                    <thead>
                        <tr>
                            <th>Subject</th>
                            <th>End of year grade</th>
                            <th>Pass/Fail</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>English</td>
                            <td>5.0</td>
                            <td class="status-pass">Pass</td>
                        </tr>
                        <tr>
                            <td>Maths</td>
                            <td>7.0</td>
                            <td class="status-pass">Pass</td>
                        </tr>
                        <tr>
                            <td>Portuguese</td>
                            <td>5.2</td>
                            <td class="status-pass">Pass</td>
                        </tr>
                        <tr>
                            <td>Physics</td>
                            <td>5.2</td>
                            <td class="status-pass">Pass</td>
                        </tr>
                        <tr>
                            <td>Business & Management</td>
                            <td>7.0</td>
                            <td class="status-pass">Pass</td>
                        </tr>
                        <tr>
                            <td>Computer Science</td>
                            <td>7.0</td>
                            <td class="status-pass">Pass</td>
                        </tr>
                        <tr>
                            <td>Theory of Knowledge</td>
                            <td>Pass</td>
                            <td class="status-pass">Pass</td>
                        </tr>
                        <tr>
                            <td>IB Extended Essay</td>
                            <td>Pass</td>
                            <td class="status-pass">Pass</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <%- include('../components/lowerBar.ejs') %>
    <script>
        const ctx = document.getElementById('reportsChart').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['English', 'Maths', 'Portuguese', 'Physics', 'Business & Management', 'Computer Science'],
                datasets: [{
                    label: 'End of year grade',
                    data: [5.0, 7.0, 5.2, 5.2, 7.0, 7.0],
                    backgroundColor: '#2F4050',
                    borderColor: '#1a2530',
                    borderWidth: 1
                }]
            },
            options: {
                scales: {
                    y: {
                        beginAtZero: true
                    }
                },
                responsive: true,
                maintainAspectRatio: false
            }
        });
    </script>
</body>

</html>