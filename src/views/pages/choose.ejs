<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Choose Student</title>
  <link rel="stylesheet" href="/public/css/choose.css">
</head>

<body>
  <div class="first-main">
    <div class="photo-main">
      <img src="/assets/PNG_images/image 20.png" alt="" srcset="">
    </div>
    <div class="choose-main">
      <div class="logo-choose-main">
        <img src="/assets/PNG_images/Frame 6.png" alt="Diana-platform-logo">
        <p>Welcome to Diana: the St. Paul's School Parent's Portal!</p>
        <p>Please, select the student access below:</p>
      </div>
      <div class="choose-student-box-main">
        <div class="student-cards-row" id="student-cards">
          <!-- Student cards will be dynamically inserted here -->
        </div>
      </div>
    </div>
  </div>
  <div class="second-main">
    <img src="/assets/PNG_images/BRAND_ST PAULS_White Outline (2) 1.png">
    <p>We are the British school of São Paulo. At St. Paul's we always strive to be the best we can be. We have the
      courage of our convictions, essential <br> values, and the freedom to imagine and create. This is achieved through
      our
      high-quality British and Brazilian holistic education which <br> drives the personal and academic development of
      pupils, within a caring, inclusive and united community.  </p>
  </div>
  <div class="footer">
    <div class="socials">
      <a target="_blank" href="https://www.stpauls.br/"><img src="/assets/PNG_images/St._Paul's_School_new_logo_2016 1.png"
          alt="st-pauls-loog"></a>
      <a target="_blank" href="https://www.instagram.com/stpaulsschoolsp/?hl=pt"><img
          src="/assets/PNG_images/Instagram Old.png" alt="instagram"></a>
      <a target="_blank" href="https://www.facebook.com/StPaulsschoolSP/?locale=pt_BR"><img
          src="/assets/PNG_images/Facebook.png" alt="facebook"></a>
      <a target="_blank" href="https://www.linkedin.com/school/stpaulsschool/people/?originalSubdomain=br"><img
          src="/assets/PNG_images/linkedin.png" alt="linkedin"></a>
    </div>
    <p>Copyright © 2025 Saint Pauls. All rights reserved. Privacy Policy. All rights reserved by Saint Paul.</p>
  </div>
  <script>
    document.addEventListener('DOMContentLoaded', async () => {
      const user = JSON.parse(window.localStorage.getItem('user'));

      if (!user) {
        window.location.href = '/login';
        return;
      }

      const parentId = user.id;

      try {
        const response = await fetch(`/users/${parentId}/students`);
        if (!response.ok) {
          throw new Error('Failed to fetch students');
        }
        const students = await response.json();

        const studentCardsContainer = document.getElementById('student-cards');
        studentCardsContainer.innerHTML = ''; // Clear existing cards

        if (students.length > 0) {
          students.forEach(student => {
            const card = document.createElement('div');
            card.className = 'student-card';
            card.onclick = () => selecionarFilho(student.id, student.student_fullname, student.profimage_url);

            const img = document.createElement('img');
            img.src = student.profimage_url || '/assets/PNG_images/avatar.png';
            img.alt = student.student_fullname;

            const name = document.createElement('h3');
            name.textContent = student.student_fullname;

            card.appendChild(img);
            card.appendChild(name);
            studentCardsContainer.appendChild(card);
          });
        } else {
            studentCardsContainer.innerHTML = '<p>No students found for this user.</p>';
        }

      } catch (error) {
        console.error('Error fetching students:', error);
        const studentCardsContainer = document.getElementById('student-cards');
        studentCardsContainer.innerHTML = '<p>Error loading students. Please try again later.</p>';
      }
    });

    function selecionarFilho(studentId, studentName, studentImg) {
      window.localStorage.setItem('selectedStudentId', studentId);
      window.localStorage.setItem('selectedStudentName', studentName);
      window.localStorage.setItem('selectedStudentImg', studentImg || '/assets/PNG_images/avatar.png');
      window.location.href = `/profile/${studentId}`;
    }
  </script>
</body>

</html>