<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Benes and Sanctions</title>
    <link rel="icon" href="../../../assets/PNG_images/Union.png" type="image/png">
    <link href="https://fonts.googleapis.com/css2?family=Darker+Grotesque:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="public/css/benes.css">
</head>

<body>
    <!-- Top bar -->
    <%- include('../components/upperBar.ejs') %>

        <!-- Sidebar -->
        <%- include('../components/sideBar.ejs') %>

            <!-- Main content -->
            <div class="main main-content">
                <h1 class="title">
                    Benes & Sanctions
                </h1>
                <div class="content-area">
                    <div class="cards-container">
                        <div class="card-1">
                            <div class="card-title">
                                Benes
                            </div>
                            <div class="card-data">8</div>
                        </div>
                        <div class="card-2">
                            <div class="card-title">
                                Sanctions
                            </div>
                            <div class="card-data">2</div>
                        </div>
                    </div>
<div class="graph">
    <canvas id="benesChart"></canvas>
</div>
<div class="table-container">
    <table>
        <tbody>
            <tr>
                <th>Academic House:</th>
                <td id="academicHouse">Loading...</td>
            </tr>
            <tr>
                <th>Form:</th>
                <td id="form">Loading...</td>
            </tr>
            <tr>
                <th>Year:</th>
                <td id="year">Loading...</td>
            </tr>
            <tr>
                <th>Positive[PTS]:</th>
                <td id="benesPts">Loading...</td>
            </tr>
            <tr>
                <th>Negative[PTS]:</th>
                <td id="sanctionsPts">Loading...</td>
            </tr>
            <tr>
                <th>Total[PTS]:</th>
                <td id="totalPts">Loading...</td>
            </tr>
        </tbody>
    </table>
</div>
</div>
</div>

<!-- Footer -->
<%- include('../components/lowerBar.ejs') %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        fetch('/benes-data')
            .then(response => response.json())
            .then(data => {
                // Atualiza a tabela
                document.getElementById('academicHouse').innerText = data.academicHouse;
                document.getElementById('form').innerText = data.form;
                document.getElementById('year').innerText = data.year;
                document.getElementById('benesPts').innerText = `${data.benes}[${data.benesPoints}]`;
                document.getElementById('sanctionsPts').innerText = `${data.sanctions}[${data.sanctionsPoints}]`;
                document.getElementById('totalPts').innerText = `${data.total}[${data.totalPoints}]`;

                // Updates the graphic
                const ctx = document.getElementById('benesChart').getContext('2d');
                new Chart(ctx, {
                    type: 'pie',
                    data: {
                        labels: ['Benes', 'Sanctions'],
                        datasets: [{
                            data: [data.benes, data.sanctions],
                            backgroundColor: ['#B82121', '#0B364C']
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });
            })
            .catch(error => {
                console.error('Error in loading data:', error);
            });
    </script>

</body>

</html>