<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Customer Service</title>
</head>

<body style="margin: 0; padding: 0;">
    <!-- Top bar -->
    <%- include('../components/upperBar.ejs') %>
        <!-- Sidebar -->
        <%- include('../components/sideBar.ejs') %>

            <!-- Customer service contact boxes -->
            <div style="
        position: absolute;
        left: 200px; top: 70px; right: 0; bottom: 50px;
        display: flex; flex-direction: column; align-items: center;
        background: #fff;
    ">
                <!-- Email box -->
                <div id="emailBox" onclick="copyEmail(event)" style="
            cursor: pointer; margin-top: 50px; width: 490px; height: 75px; background: #000;
            border-radius: 30px; color: #fff; display: flex; align-items: center;
            justify-content: left; padding-left: 20px; font-size: 30px;
        " title="Click to copy email">
                    <img src="../../assets/PNG_images/email.png" alt="Email" style="height: 40px; margin: 0 10px;" />
                    <span id="emailText">E-mail</span>
                    <span id="realEmail" style="display:none;">DPO@stpauls.br</span>
                </div>
                <!-- Telephone box -->
                <div id="telephoneBox" onclick="copyTelephone(event)" style="
            cursor: pointer; margin-top: 20px; width: 490px; height: 75px; background: #000;
            border-radius: 30px; color: #fff; display: flex; align-items: center;
            justify-content: left; padding-left: 20px; font-size: 30px;
        " title="Click to copy telephone">
                    <img src="../../assets/PNG_images/telephone.png" alt="Telephone"
                        style="height: 40px; margin: 0 10px;" />
                    <span id="telephoneText">Telephone</span>
                    <span id="realTelephone" style="display:none;">(5511) 3087-3399</span>
                </div>
                <!-- LinkedIn box -->
                <div style="
            margin-top: 20px; width: 480px; height: 75px; background: #000;
            border-radius: 30px; color: #fff; display: flex; align-items: center;
            justify-content: left; padding-left: 35px; font-size: 30px; cursor: pointer;"
                    onclick="window.open('https://www.linkedin.com/school/stpaulsschool','_blank')">
                    <img src="../../assets/PNG_images/linkedin.png" alt="Linkedin"
                        style="height: 40px; margin-right: 10px; vertical-align: middle;">
                    <span style="color: #fff; text-decoration: none;">LinkedIn</span>
                </div>
                <!-- Instagram box -->
                <div style="
            margin-top: 20px; width: 480px; height: 75px; background: #000;
            border-radius: 30px; color: #fff; display: flex; align-items: center;
            justify-content: left; padding-left: 35px; font-size: 30px; cursor: pointer;"
                    onclick="window.open('https://instagram.com/stpaulsschoolsp','_blank')">
                    <img src="../../assets/PNG_images/instagram.png" alt="Instagram"
                        style="height: 40px; margin-right: 10px; vertical-align: middle;">
                    <span style="color: #fff; text-decoration: none;">Instagram</span>
                </div>
            </div>


                <!-- Copy to clipboard scripts -->
                <script>
                    function copyEmail(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        // Copies email to clipboard
                        const email = document.getElementById('realEmail').textContent;
                        navigator.clipboard.writeText(email).then(function () {
                            alert('Email copied to clipboard!');
                        });
                    }
                    function copyTelephone(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        // Copies telephone to clipboard
                        const tel = document.getElementById('realTelephone').textContent;
                        navigator.clipboard.writeText(tel).then(function () {
                            alert('Telephone copied to clipboard!');
                        });
                    }
                </script>
</body>

</html>