<head>
  <link href="https://fonts.googleapis.com/css2?family=Darker+Grotesque:wght@400;600&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
  <style>
    .sidebar {
      width: 200px;
      height: 100vh;
      background: linear-gradient(180deg, #0B364C 0%, #0A2D3F 100%);
      color: white;
      text-align: center;
      position: fixed;
      top: 70px;
      left: 0;
      border-right: 1px solid rgba(255, 255, 255, 0.1);
      display: flex;
      flex-direction: column;
      align-items: center;
      font-family: 'Darker Grotesque', sans-serif;
      padding: 25px 0;
      box-shadow: 1px 0 2px rgba(1, 1, 1, 5);
      z-index: 1000;
      overflow-y: auto;
    }

    .sidebar-button {
      width: 180px;
      height: 45px;
      background: rgba(255, 255, 255, 0.05);
      border-radius: 10px;
      color: rgba(255, 255, 255, 0.9);
      display: flex;
      align-items: center;
      justify-content: flex-start;
      padding: 0 15px;
      margin: 6px 0;
      transition: all 0.3s ease;
      font-size: 14px;
      border: 1px solid rgba(255, 255, 255, 0.05);
      position: relative;
      overflow: hidden;
    }

    .sidebar-button::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      height: 100%;
      width: 3px;
      background: #B82121;
      transform: scaleY(0);
      transition: transform 0.3s ease;
    }

    .sidebar-button:hover::before {
      transform: scaleY(1);
    }

    .sidebar-button i {
      margin-right: 12px;
      width: 20px;
      text-align: center;
      font-size: 16px;
      color: rgba(255, 255, 255, 0.7);
      transition: all 0.3s ease;
    }

    .sidebar-button:hover {
      background: rgba(255, 255, 255, 0.1);
      transform: translateX(5px);
      cursor: pointer;
    }

    .sidebar-button:hover i {
      color: #B82121;
    }

    .sidebar-button.active {
      background: rgba(255, 255, 255, 0.1);
      border-left: 3px solid #B82121;
    }

    .sidebar-button.active i {
      color: #B82121;
    }

    .sidebar-section {
      width: 100%;
      margin: 15px 0;
      padding: 0 10px;
      flex-shrink: 0;
    }

    .sidebar-section-title {
      color: rgba(255, 255, 255, 0.4);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin: 20px 0 10px 0;
      padding: 0 15px;
      text-align: left;
      font-weight: 600;
    }

    .sidebar-divider {
      height: 1px;
      background: rgba(255, 255, 255, 0.1);
      margin: 10px 20px;
    }

    .sidebar-footer {
      margin-top: auto;
      padding: 20px;
      font-size: 12px;
      color: rgba(255, 255, 255, 0.4);
      text-align: center;
      flex-shrink: 0;
    }

    /* Ajuste para o conteúdo principal */
    .main-content {
      margin-left: 200px;
      padding: 90px 20px 20px 20px;
      min-height: calc(100vh - 70px);
      box-sizing: border-box;
    }

    @media (max-width: 768px) {
      .sidebar {
        width: 60px;
        padding-top: 60px;
      }

      .main-content {
        margin-left: 60px;
      }
    }
  </style>
</head>

<div class="sidebar">
  <div class="sidebar-section">
    <div class="sidebar-section-title">Academic</div>
    <a href="/events" style="text-decoration: none; color: inherit;">
      <div class="sidebar-button">
        <i class="fas fa-calendar-alt"></i>
        Events
      </div>
    </a>
    <a href="/assignments" style="text-decoration: none; color: inherit;">
      <div class="sidebar-button">
        <i class="fas fa-tasks"></i>
        Assignments
      </div>
    </a>
    <a href="/timetable" style="text-decoration: none; color: inherit;">
      <div class="sidebar-button">
        <i class="fas fa-clock"></i>
        Timetable
      </div>
    </a>
    <a href="/benes" style="text-decoration: none; color: inherit;">
      <div class="sidebar-button">
        <i class="fas fa-award"></i>
        Benes
      </div>
    </a>
    <a href="/reports" style="text-decoration: none; color: inherit;">
      <div class="sidebar-button">
        <i class="fas fa-chart-bar"></i>
        Reports
      </div>
    </a>
  </div>

  <div class="sidebar-divider"></div>

  <div class="sidebar-section">
    <div class="sidebar-section-title">Support</div>
    <a href="/communication" style="text-decoration: none; color: inherit;">
      <div class="sidebar-button">
        <i class="fas fa-comments"></i>
        Communication
      </div>
    </a>
  </div>

  <div class="sidebar-divider"></div>


  <div class="sidebar-footer">
    St. Paul's School © 2024
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const currentPath = window.location.pathname;
    const buttons = document.querySelectorAll('.sidebar-button');
    
    buttons.forEach(button => {
      const link = button.parentElement.getAttribute('href');
      if (currentPath === link) {
        button.classList.add('active');
      }
    });
  });
</script>
